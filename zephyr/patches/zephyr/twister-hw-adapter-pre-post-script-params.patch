From a2aaa3dbf04a9c05008a0e17546ee163188a0eb3 Mon Sep 17 00:00:00 2001
From: Joel Guittet <jguittet@witekio.com>
Date: Wed, 17 Jun 2026 09:13:05 +0200
Subject: [PATCH 2/4] twister: move pre-script execution before flashing and
 connecting

Depending on the `flash_before` configuration, the pre-script
was not always called first. It's now called before flashing and
connecting whatever the configuration is.

Signed-off-by: Joel Guittet <jguittet@witekio.com>
---
 .../src/twister_harness/device/hardware_adapter.py           | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
index 1c685d9b4ec..a312f401b93 100644
--- a/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
+++ b/scripts/pylib/pytest-twister-harness/src/twister_harness/device/hardware_adapter.py
@@ -115,6 +115,8 @@ class HardwareAdapter(DeviceAdapter):
 
     def _device_launch(self) -> None:
         """Flash and run application on a device and connect with serial port."""
+        if self.device_config.pre_script:
+            self._run_custom_script(self.device_config.pre_script, self.base_timeout)
         if self.device_config.flash_before:
             # For hardware devices with shared USB or software USB, connect after flashing.
             # Retry for up to 10 seconds for USB-CDC based devices to enumerate.
@@ -143,9 +145,6 @@ class HardwareAdapter(DeviceAdapter):
             logger.error(msg)
             raise TwisterHarnessException(msg)
 
-        if self.device_config.pre_script:
-            self._run_custom_script(self.device_config.pre_script, self.base_timeout)
-
         if self.device_config.id:
             logger.debug('Flashing device %s', self.device_config.id)
         log_command(logger, 'Flashing command', self.command, level=logging.DEBUG)
-- 
